# Note: Tailor this file strictly to your repository's tech stack.
# Only include patterns for tools and languages actually used in this project.
# E.g., if the project does not use Node.js, remove the Node.js section;
# if it does not use Python, remove the Python section.

# Version control
.git
.gitignore
.gitattributes

# Environment & local secrets
.env*
!.env.example
*.pem
*.key

# Python artifacts & caches (keep only if Python is used)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js artifacts & caches (keep only if Node.js is used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
build/
dist/
*.egg-info/
target/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Documentation & CI/CD configs not needed in image
docs/
.github/
.gitlab/
README.md
CONTRIBUTING.md
CHANGELOG.md
